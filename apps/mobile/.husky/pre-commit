#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run linter
echo "🔍 Running linter..."
cd apps/mobile && npm run lint

# Run unit tests
echo "🧪 Running unit tests..."
cd apps/mobile && npm run test:unit

# Run integration tests if mobile files changed
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "apps/mobile" || true)

if [ -n "$CHANGED_FILES" ]; then
  echo "📱 Mobile files changed, running integration tests..."
  cd apps/mobile && npm run test:integration
fi

echo "✅ Pre-commit checks passed!"

