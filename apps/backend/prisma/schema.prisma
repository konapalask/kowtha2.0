datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  Admin
  Verifier
  FieldExecutive
  SupportExecutive
  OperationsExecutive
}

enum UserStatus {
  Active
  Inactive
}

enum VerificationType {
  AddressOne
  AddressTwo
  Work
  Business
}

enum AddressType {
  PermanentAddress
  CurrentAddress
  Work
  Business
}

enum PictureSource {
  Camera
  Gallery
}

enum DocumentType {
  ID
  Address
  Income
  Other
}

enum VerificationStatus {
  Pending
  InProgress
  Completed
}

enum ApprovedStatus {
  Positive
  Negative
}

enum LoanStatus {
  Unassigned
  Assigned
  UnderFV
  FVCompleted
  Approved
  Rejected
}

enum FieldExecutiveStatus {
  Pending
  InProgress
  Completed
}

enum EditRequestStatus {
  Pending
  Approved
  Rejected
}

enum EditRequestType {
  Login
  LoanData
  Other
}

enum AttendanceStatus {
  Available
  Unavailable
}

enum LocationType {
  Local
  Remote
}

enum Department {
  FI
  PD
}

model User {
  id                       Int                  @id @default(autoincrement())
  mobile                   String               @unique
  name                     String
  email                    String?              @unique
  employeeCode             String?
  locality                 String?
  deviceId                 String?
  defaultDepartment        Department?
  status                   UserStatus           @default(Active)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  // Relations
  operationsExecutiveLoans Loan[]               @relation("OperationsExecutive")
  verifications            Verification[]       @relation("VerificationFieldExecutive")
  verificationsVerifier    Verification[]       @relation("VerificationVerifier")
  sessions                 Session[]
  editRequestsRequested    EditRequest[]        @relation("EditRequestRequester")
  editRequestsApproved     EditRequest[]        @relation("EditRequestApprover")
  attendances              Attendance[]         @relation("UserAttendance")
  verificationRetries      VerificationRetries[]
  departmentRoles          DepartmentRole[]     @relation("UserDepartmentRole")
}


model DepartmentRole {
  id          Int      @id @default(autoincrement())
  user        User     @relation("UserDepartmentRole", fields: [userId], references: [id])
  userId      Int
  department  Department
  role        UserRole
  officeId    Int?
  office      Office?   @relation(fields: [officeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, department])
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  offices     Office[]
}

model Office {
  id                  Int          @id @default(autoincrement())
  name                String
  location            String
  address             String
  department          Department?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  loans               Loan[]
  archived            Boolean      @default(false)
  organizationId      Int          @default(1)
  organization        Organization @relation(fields: [organizationId], references: [id])
  departmentRoles     DepartmentRole[]
}

model Loan {
  id                      Int                 @id @default(autoincrement())
  applicationNumber       String              
  applicantName           String
  applicantMobile         String
  applicantAddress        String?
  applicantAddress1       String?
  applicantAddress2       String?
  isAddressSame           Boolean             @default(false)
  loanType                String
  bankName                String
  loanAmount              Float?
  status                  LoanStatus
  department              Department?
  officeId                Int
  office                  Office              @relation(fields: [officeId], references: [id])
  operationsExecutiveId   Int?
  operationsExecutive     User?               @relation("OperationsExecutive", fields: [operationsExecutiveId], references: [id])
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  reassignCount           Int                 @default(0)
  applicantType           String?
  editRequests            EditRequest[]
  verifications           Verification[]
  pdEmailLogs             PDEmailLog[]
  @@unique([applicationNumber, applicantType, department, reassignCount]) // New optional field
}

model Verification {
  id                    Int                @id @default(autoincrement())
  loanId                Int
  loan                  Loan               @relation(fields: [loanId], references: [id])
  type                  VerificationType
  addressType           AddressType?
  approvedStatus        ApprovedStatus?
  department            Department?
  verifierId            Int?
  verifier              User?               @relation("VerificationVerifier", fields: [verifierId], references: [id])
  fieldExecutiveId      Int
  fieldExecutive        User               @relation("VerificationFieldExecutive", fields: [fieldExecutiveId], references: [id])
  status                VerificationStatus
  locationType          LocationType?
  isPostponed           Boolean?
  postponedDate         DateTime?
  postponedReason       String?
  businessName          String?
  financialAnalysis     Json?
  synopsis              String?
  currentOfficeName     String?
  path                  String? // Array of S3 paths for verification documents
  finalReportPath       String? // S3 path for final report
  applicantAddress      String?
  verificationData      Json? // JSON field to store address/work data
  pictureSource         PictureSource? // Source of the uploaded picture
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  editRequests          EditRequest[] // Add this relation
  verificationRetries   VerificationRetries[]
  @@unique([loanId, type])
}

model VerificationRetries {
  id                  Int @id @default(autoincrement())
  verificationId      Int
  verification        Verification @relation(fields: [verificationId], references: [id])
  date                DateTime
  geotag              String?
  address             String?
  reason              String?
  fieldExecutiveId    Int
  fieldExecutive      User         @relation(fields: [fieldExecutiveId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  otp         String?
  otpExpires  DateTime?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  isActive    Boolean   @default(true)
}

model EditRequest {
  id             Int               @id @default(autoincrement())
  loanId         Int?
  loan           Loan?              @relation(fields: [loanId], references: [id])
  verificationId Int?
  verification   Verification?     @relation(fields: [verificationId], references: [id])
  requestedBy    Int
  requester      User              @relation("EditRequestRequester", fields: [requestedBy], references: [id])
  approvedBy     Int?
  approver       User?             @relation("EditRequestApprover", fields: [approvedBy], references: [id])
  status         EditRequestStatus
  department     Department?
  changes        Json // Stores the proposed changes
  remarks        String?
  type           EditRequestType?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Attendance {
  id             Int              @id @default(autoincrement())
  userId         Int
  user           User             @relation("UserAttendance", fields: [userId], references: [id])
  date           DateTime
  status         AttendanceStatus
  department     Department?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model AppDeployment {
  id            Int   @id @default(autoincrement())
  version       String
  isActive      Boolean @default(true)
  source        String
  forceUpdate   Boolean @default(false)
  appStoreUrl   String?
  playStoreUrl  String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PDEmailLog {
  id          Int      @id @default(autoincrement())
  messageID   String
  fromEmail   String[]
  toEmail     String[]
  ccEmail     String[]
  bccEmail    String[]
  subject     String
  body        String
  attachments String[]
  receivedAt  DateTime?
  parsedData  Json?
  s3Path      String?
  
  loanId      Int?
  loan        Loan?    @relation(fields: [loanId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bank {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  logo        String?
  parent      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}