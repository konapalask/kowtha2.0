generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                       Int                   @id @default(autoincrement())
  mobile                   String                @unique
  name                     String
  email                    String?               @unique
  employeeCode             String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  status                   UserStatus            @default(Active)
  deviceId                 String?
  locality                 String?
  defaultDepartment        Department?
  attendances              Attendance[]          @relation("UserAttendance")
  departmentRoles          DepartmentRole[]      @relation("UserDepartmentRole")
  editRequestsApproved     EditRequest[]         @relation("EditRequestApprover")
  editRequestsRequested    EditRequest[]         @relation("EditRequestRequester")
  operationsExecutiveLoans Loan[]                @relation("OperationsExecutive")
  sessions                 Session[]
  verifications            Verification[]        @relation("VerificationFieldExecutive")
  verificationsVerifier    Verification[]        @relation("VerificationVerifier")
  verificationRetries      VerificationRetries[]
  closedLoans              Loan[]                @relation("UserClosedLoans")
}

model DepartmentRole {
  id         Int        @id @default(autoincrement())
  userId     Int
  department Department
  role       UserRole
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  officeId   Int?
  office     Office?    @relation(fields: [officeId], references: [id])
  user       User       @relation("UserDepartmentRole", fields: [userId], references: [id])

  @@unique([userId, department])
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  offices     Office[]
}

model Office {
  id              Int              @id @default(autoincrement())
  name            String
  location        String
  address         String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archived        Boolean          @default(false)
  organizationId  Int              @default(1)
  department      Department?
  departmentRoles DepartmentRole[]
  loans           Loan[]
  organization    Organization     @relation(fields: [organizationId], references: [id])
}

model Loan {
  id                    Int            @id @default(autoincrement())
  applicationNumber     String
  applicantName         String
  applicantMobile       String
  applicantAddress      String?
  applicantAddress1     String?
  applicantAddress2     String?
  isAddressSame         Boolean        @default(false)
  loanType              String
  bankName              String
  loanAmount            Float?
  status                LoanStatus
  officeId              Int
  operationsExecutiveId Int?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  closedAt              DateTime?     
  closedById            Int?          
  applicantType         String?
  department            Department?
  reassignCount         Int            @default(0)
  templateName          String?
  editRequests          EditRequest[]
  office                Office         @relation(fields: [officeId], references: [id])
  closedBy              User?          @relation("UserClosedLoans", fields: [closedById], references: [id])
  operationsExecutive   User?          @relation("OperationsExecutive", fields: [operationsExecutiveId], references: [id])
  pdEmailLogs           PDEmailLog[]
  verifications         Verification[]

  @@unique([applicationNumber, applicantType, department, reassignCount])
}

model Verification {
  id                  Int                   @id @default(autoincrement())
  loanId              Int
  type                VerificationType
  fieldExecutiveId    Int
  status              VerificationStatus
  applicantAddress    String?
  verificationData    Json?
  pictureSource       PictureSource?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  addressType         AddressType?
  path                String?
  approvedStatus      ApprovedStatus?
  finalReportPath     String?
  locationType        LocationType?
  verifierId          Int?
  businessName        String?
  isPostponed         Boolean?
  initialSubmitted    Boolean? @default(false)
  postponedDate       DateTime?
  postponedReason     String?
  currentOfficeName   String?
  department          Department?
  financialAnalysis   Json?
  synopsis            String?
  templateName        String?
  editRequests        EditRequest[]
  fieldExecutive      User                  @relation("VerificationFieldExecutive", fields: [fieldExecutiveId], references: [id])
  loan                Loan                  @relation(fields: [loanId], references: [id])
  verifier            User?                 @relation("VerificationVerifier", fields: [verifierId], references: [id])
  verificationRetries VerificationRetries[]

  @@unique([loanId, type])
}

model VerificationRetries {
  id               Int          @id @default(autoincrement())
  verificationId   Int
  date             DateTime
  geotag           String?
  address          String?
  reason           String?
  fieldExecutiveId Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  fieldExecutive   User         @relation(fields: [fieldExecutiveId], references: [id])
  verification     Verification @relation(fields: [verificationId], references: [id])
}

model Session {
  id          Int       @id @default(autoincrement())
  userId      Int
  otp         String?
  otpExpires  DateTime?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  isActive    Boolean   @default(true)
  user        User      @relation(fields: [userId], references: [id])
}

model EditRequest {
  id             Int               @id @default(autoincrement())
  loanId         Int?
  verificationId Int?
  requestedBy    Int
  approvedBy     Int?
  status         EditRequestStatus
  changes        Json
  remarks        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  type           EditRequestType?
  department     Department?
  approver       User?             @relation("EditRequestApprover", fields: [approvedBy], references: [id])
  loan           Loan?             @relation(fields: [loanId], references: [id])
  requester      User              @relation("EditRequestRequester", fields: [requestedBy], references: [id])
  verification   Verification?     @relation(fields: [verificationId], references: [id])
}

model Attendance {
  id         Int              @id @default(autoincrement())
  userId     Int
  date       DateTime?
  status     AttendanceStatus
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  department Department?
  user       User             @relation("UserAttendance", fields: [userId], references: [id])
}

model AppDeployment {
  id           Int      @id @default(autoincrement())
  version      String
  isActive     Boolean  @default(true)
  source       String
  forceUpdate  Boolean  @default(false)
  appStoreUrl  String?
  playStoreUrl String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PDEmailLog {
  id          Int       @id @default(autoincrement())
  messageID   String
  fromEmail   String[]
  toEmail     String[]
  ccEmail     String[]
  bccEmail    String[]
  subject     String
  body        String
  attachments String[]
  receivedAt  DateTime?
  parsedData  Json?
  s3Path      String?
  loanId      Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  loan        Loan?     @relation(fields: [loanId], references: [id])
}

model Bank {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  logo      String?
  parent    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  Admin
  Verifier
  FieldExecutive
  SupportExecutive
  OperationsExecutive
  VerificationExecutive
}

enum UserStatus {
  Active
  Inactive
}

enum VerificationType {
  AddressOne
  AddressTwo
  Work
  Business
}

enum AddressType {
  PermanentAddress
  CurrentAddress
  Work
  Business
}

enum PictureSource {
  Camera
  Gallery
}

enum DocumentType {
  ID
  Address
  Income
  Other
}

enum VerificationStatus {
  Pending
  InProgress
  Completed
}

enum ApprovedStatus {
  Positive
  Negative
  CreditRefer
}

enum LoanStatus {
  Unassigned
  Assigned
  UnderFV
  FVCompleted
  Approved
  Rejected
}

enum FieldExecutiveStatus {
  Pending
  InProgress
  Completed
}

enum EditRequestStatus {
  Pending
  Approved
  Rejected
}

enum EditRequestType {
  Login
  LoanData
  FinancialAnalysis
  Other
}

enum AttendanceStatus {
  Available
  Unavailable
}

enum LocationType {
  Local
  Remote
}

enum Department {
  FI
  PD
}
